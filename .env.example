# Chaîne de connexion PostgreSQL
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threadify?schema=public"

# Better Auth
# Clé secrète (au moins 32 caractères aléatoires). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="remplacez-moi-par-une-cle-secrete-aleatoire"
# Adresse du site (en local : http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# IA (Claude, Anthropic) — clé API créée sur https://platform.claude.com
# (Settings → API keys). Ne jamais la partager ni la mettre sur GitHub.
ANTHROPIC_API_KEY="sk-ant-remplacez-moi"

# Administration — adresse(s) e-mail autorisée(s) à voir la page cachée
# /admin/couts (séparées par des virgules). Ne pas mettre sur GitHub.
ADMIN_EMAILS="votre-adresse@exemple.fr"
# Taux de conversion approximatif dollar → euro pour la page des coûts
USD_EUR_RATE="0.92"

# Paiement (Stripe, mode test) — voir docs/tester-etape-7.md
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_EXPERT=""

# E-mails (étape 8a) — service Resend (resend.com). Sans clé, les e-mails ne
# partent pas : leur lien s'affiche dans la fenêtre noire (npm run dev).
RESEND_API_KEY=""
# Expéditeur. Pour les tests : "Threadify <onboarding@resend.dev>" (n'envoie qu'à
# l'adresse de votre compte Resend). En production : une adresse de votre domaine.
EMAIL_FROM="Threadify <onboarding@resend.dev>"
