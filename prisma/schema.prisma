// Schéma Prisma de Threadify
// Étape 1 : modèles d'authentification (Better Auth).
// Étape 2 : créations (idée ou article + format choisi).
// Étape 3 : contenu généré par l'IA.
// Étape 4 : design des carrousels.
// Étape 6 : titres, dossiers et étiquettes.
// Étape 7 : abonnements Stripe et compteur de générations.
// Étape 8a : limitation des tentatives (rate limit) et suppression de compte.
// Étape 9 : programme d'affiliation (parrainage, commissions, versements).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentification (Better Auth) ───────────────────────────────────────────
// Modèles attendus par Better Auth (e-mail + mot de passe). Ne pas renommer les
// champs : l'adaptateur Prisma de Better Auth s'appuie sur ces noms.

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  accounts         Account[]
  creations        Creation[]
  folders          Folder[]
  // Étape 7 : abonnement (extension Stripe de Better Auth) et compteur de générations
  stripeCustomerId String?
  generationEvents GenerationEvent[]
  // Étape 9 : affiliation. referralCode = code personnel (créé à la 1re visite de
  // la page Affiliation) ; referredBy = l'affilié qui a invité ce compte.
  referralCode     String?           @unique
  referredById     String?
  referredBy       User?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredAt       DateTime?
  referrals        User[]            @relation("Referrals")
  commissions      Commission[]      @relation("AffiliateCommissions")
  referredCommissions Commission[]   @relation("ReferredCommissions")
  payouts          Payout[]

  @@index([referredById])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Créations ────────────────────────────────────────────────────────────────

enum SourceType {
  IDEE
  ARTICLE
}

enum CreationFormat {
  CARROUSEL_INSTAGRAM
  CARROUSEL_LINKEDIN
  THREAD_X
}

enum CreationStatus {
  BROUILLON // saisi, pas encore généré par l'IA
  GENERE // contenu généré par l'IA (voir Creation.content)
}

model Creation {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType  SourceType
  sourceText  String
  format      CreationFormat
  status      CreationStatus @default(BROUILLON)
  // Résultat de l'IA : { type: "carrousel", slides: [{ titre, texte }] }
  // ou { type: "thread", tweets: [string] } (voir src/lib/generation.ts)
  content     Json?
  generatedAt DateTime?
  model       String? // modèle d'IA utilisé pour la dernière génération
  // Réglages de design du carrousel (modèle, couleurs, police, signature)
  // — voir src/lib/design.ts
  design      Json?
  // Étape 6 : organisation
  title       String? // titre choisi par l'utilisateur (sinon titre déduit du contenu)
  folderId    String?
  folder      Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags        String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([userId, folderId])
  @@map("creation")
}

// Dossiers de l'utilisateur (ex. un dossier par client). Supprimer un dossier
// ne supprime pas ses créations : elles passent « sans dossier ».
model Folder {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  creations Creation[]

  @@unique([userId, name])
  @@map("folder")
}

// ─── Abonnements (étape 7) ────────────────────────────────────────────────────
// Table attendue par l'extension Stripe de Better Auth (@better-auth/stripe) :
// ne pas renommer les champs. referenceId = id de l'utilisateur abonné.

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@map("subscription")
}

// Une ligne par génération réussie (génération ou régénération) : sert aux
// quotas mensuels des offres et au garde-fou horaire de l'offre Expert.
model GenerationEvent {
  id           String   @id @default(cuid())
  // Compte supprimé : la ligne reste (anonyme) pour l'historique des coûts.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  creationId   String?
  createdAt    DateTime @default(now())
  // Coût réel de la génération (suivi réservé à l'administrateur, page /admin/couts)
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("generation_event")
}

// Limitation des tentatives (connexion, inscription, e-mails) par Better Auth.
// Stockée en base pour fonctionner aussi sur un hébergeur à plusieurs serveurs.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Étape 9 : affiliation ────────────────────────────────────────────────────

enum CommissionStatus {
  PENDING   // en attente (30 jours) puis disponible quand availableAt est passée
  PAID      // versée à l'affilié
  CANCELLED // paiement remboursé avant versement
  REVERSED  // paiement remboursé après versement : déduite des gains suivants
}

// Une commission par facture Stripe payée par un filleul (30 % du montant HT).
model Commission {
  id              String           @id @default(cuid())
  affiliateId     String
  affiliate       User             @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String?
  referredUser    User?            @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: SetNull)
  stripeInvoiceId String           @unique
  paidAt          DateTime         // date du paiement du filleul
  availableAt     DateTime         // paidAt + 30 jours
  paidCents       Int              // montant payé par le filleul (TTC)
  baseCents       Int              // base de calcul (HT)
  amountCents     Int              // commission
  status          CommissionStatus @default(PENDING)
  payoutId        String?
  payout          Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([affiliateId, status])
  @@index([paidAt])
  @@map("commission")
}

// Un virement fait à la main par l'administrateur à un affilié.
model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   User         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime     @default(now())
  commissions Commission[]

  @@index([affiliateId])
  @@map("payout")
}
