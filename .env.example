# Chaîne de connexion PostgreSQL
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threadify?schema=public"

# Better Auth
# Clé secrète (au moins 32 caractères aléatoires). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="remplacez-moi-par-une-cle-secrete-aleatoire"
# Adresse du site (en local : http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
